{
  "name": "booked-up",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npx tsc",
    "start": "node --es-module-specifier-resolution=node --no-warnings ./dist/index.js",
    "clean": "rimraf ./dist ./tsconfig.tsbuildinfo",
    "compile": "npm run clean && npx tsc --watch",
    "lint": "eslint .",
    "sync": "npx tsx scripts/sync.ts"
  },
  "devDependencies": {
    "@types/argon2": "^0.14.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  }
}
